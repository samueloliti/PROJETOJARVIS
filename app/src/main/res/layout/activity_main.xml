<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS"
            android:textColor="@color/jarvis_accent"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caseiro"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- Card de status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/jarvis_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/dotStatusFirebase"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_status_dot"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/txtStatusFirebase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_desconectado"
                    android:textColor="@color/jarvis_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ID: --"
                android:textColor="@color/jarvis_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtServicoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Serviço: parado"
                android:textColor="@color/jarvis_text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleServico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/jarvis_accent"
            android:text="@string/iniciar_servico"
            android:textColor="@color/jarvis_bg"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissões pendentes"
            android:textColor="@color/jarvis_text"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtPermissoesPendentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificando…"
            android:textColor="@color/jarvis_error"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos comandos"
            android:textColor="@color/jarvis_text"
            android:textSize="15sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtUltimosComandos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhum comando recebido ainda."
            android:textColor="@color/jarvis_text_dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
